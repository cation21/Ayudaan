# --- Database ---
DATABASE_URL=postgresql://ayudaan:ayudaan@localhost:5432/ayudaan

# --- Auth: Default Login (individuals) — spec section 9 ---
# NOTE: must be different from ORG_JWT_SECRET below, or the two login
# surfaces become indistinguishable — see auth/env.ts, which refuses to
# start the server if these two ever match.
JWT_SECRET=change-me-individual-login-secret

# --- Auth: Organizational Login (NGOs/Companies) — spec section 9 ---
ORG_JWT_SECRET=change-me-org-login-secret

# --- Auth: Development/Ops Login (LOCAL/DEV ONLY — never set in production) ---
# Demo credentials for local testing: password is "devpassword123" — this
# hash is real bcrypt output for that password, not a placeholder string,
# so /dev-login actually works out of the box locally.
DEV_ADMIN_EMAIL=dev@example.com
DEV_ADMIN_PASSWORD_HASH="$2a$10$bo8fpFl3vMd8589BDSXkgeCMnizhHn.mCWa.3e2Q7l1VKigUvWgVe"
DEV_JWT_SECRET=change-me-dev-login-secret

# --- Payments (PaymentProvider implementations) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Polygon anchoring (ChainAnchorService / PolygonAnchorAdapter) ---
POLYGON_RPC_URL=https://polygon-rpc.com
CHAIN_ANCHOR_WALLET_PRIVATE_KEY=
CHAIN_ANCHOR_CONTRACT_ADDRESS=

# --- Identity verification (IdentityVerifier implementations) ---
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
AADHAAR_EKYC_API_KEY=

# --- API server ---
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
