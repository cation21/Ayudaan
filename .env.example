# --- Database ---
DATABASE_URL=postgresql://ayudaan:ayudaan@localhost:5432/ayudaan

# --- Auth: Default Login (individuals) — spec section 9 ---
JWT_SECRET=changeme

# --- Auth: Organizational Login (NGOs/Companies) — spec section 9 ---
ORG_JWT_SECRET=changeme

# --- Auth: Development/Ops Login (LOCAL/DEV ONLY — never set in production) ---
DEV_ADMIN_EMAIL=dev@example.com
DEV_ADMIN_PASSWORD_HASH=changeme

# --- Payments (PaymentProvider implementations) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Polygon anchoring (ChainAnchorService / PolygonAnchorAdapter) ---
POLYGON_RPC_URL=https://polygon-rpc.com
CHAIN_ANCHOR_WALLET_PRIVATE_KEY=
CHAIN_ANCHOR_CONTRACT_ADDRESS=

# --- Identity verification (IdentityVerifier implementations) ---
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
AADHAAR_EKYC_API_KEY=

# --- API server ---
PORT=4000
NODE_ENV=development
